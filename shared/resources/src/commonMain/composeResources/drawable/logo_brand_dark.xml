<?xml version="1.0" encoding="utf-8"?>
<!--
  NearYouID brand logo — dark variant (#B7C4FF dark-scheme-primary glyph,
  transparent background). Conforms to the canonical mockup board's logo
  rendering (dev/mockups/nearyou-screens-mockup.html: .frame.dark - -primary
  is #B7C4FF, stroke=currentColor) per mobile-mockup-visual-conformance:
  background plate removed, white glyph retinted to the dark-scheme primary,
  canvas cropped 108x108 -> 46x46 via the translate group; glyph pathData
  byte-preserved including the deliberate per-variant geometry differences
  vs the light asset (top-hexagon tail 43.8,43.5; right-hexagon tail 68.9,53).
  Android XML vector drawable per the CMP Resources Android constraint
  (no SVG; JetBrains #4715 / #4670).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="46dp"
    android:height="46dp"
    android:viewportWidth="46"
    android:viewportHeight="46">
    <group
        android:translateX="-31"
        android:translateY="-31">
        <!-- Top hexagon polyline (note last point 43.8,43.5 — differs
             slightly from light variant's 43.8,45.5 per source-SVG geometry) -->
        <path
            android:pathData="M43.8,50.2 L54,56.1 L64.2,50.2 L64.2,38.5 L54,32.6 L43.8,38.5 L43.8,43.5"
            android:strokeColor="#B7C4FF"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Left hexagon polyline -->
        <path
            android:pathData="M54,56.1 L43.8,50.2 L33.7,56.1 L33.7,67.9 L43.8,73.7 L46.3,73.7"
            android:strokeColor="#B7C4FF"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Right hexagon polyline (note last point 68.9,53 — differs slightly
             from light variant's 68.3,52.6 per source-SVG geometry) -->
        <path
            android:pathData="M64.2,73.7 L74.3,67.9 L74.3,56.1 L68.9,53"
            android:strokeColor="#B7C4FF"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Bottom connector line -->
        <path
            android:pathData="M64.2,73.7 L56.7,73.7"
            android:strokeColor="#B7C4FF"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Filled dot (circle at 51.5, 73.7, r=2) -->
        <path
            android:pathData="M49.5,73.7 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z"
            android:fillColor="#B7C4FF" />
    </group>
</vector>
