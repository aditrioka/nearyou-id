<?xml version="1.0" encoding="utf-8"?>
<!--
  NearYouID brand logo — light variant (blue glyph on white background).
  Converted from logo_brand_light.svg per CMP Resources Android constraint:
  SVG drawables are not supported on Android; canonical cross-platform
