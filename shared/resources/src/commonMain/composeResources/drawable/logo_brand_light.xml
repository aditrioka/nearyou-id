        android:pathData="M64.2,73.7 L56.7,73.7"
        android:strokeColor="#1E4FD6"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Filled dot (circle at 51.5, 73.7, r=2) -->
