# Mobile #3 (mobile-auth-google-signin-flow). The REAL per-env GoogleService-Info.plist is
# sensitive (paired with the iOS bundle ID via Apple's app-binding model) — pulled from GCP
# Secret Manager at build time, never committed. The .template placeholder IS tracked.
iosApp/**/GoogleService-Info.plist
# CocoaPods integration artifacts generated by the KMP cocoapods plugin / `pod install`.
iosApp/Pods/
iosApp/Podfile.lock
iosApp/*.xcworkspace/

# Claude Code session-local scratch (worktrees from /opsx skill invocations,
# scheduled-task lockfiles, etc). Ephemeral; never commit.
.claude/worktrees/
.claude/scheduled_tasks.lock

# Maestro E2E run artifacts (screenshots, mp4, logs, JUnit). Regenerated per run; never commit.
mobile/app/maestro/artifacts/

# Firebase Test Lab device-run artifacts pulled by scripts/run_on_device.sh
# (Robo screenshots, video, logs). Regenerated per run; never commit.
dev/device-runs/

