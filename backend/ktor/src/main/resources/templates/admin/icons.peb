{# Vendored inline-SVG icon macro — admin-mockup-parity design.md D2.

   Glyphs are 24dp Material Symbols / Material Icons OUTLINED paths
   (Copyright Google LLC, Apache License 2.0 —
   https://github.com/google/material-design-icons/blob/master/LICENSE).
   Vendored as inline SVG (not the icon font): the panel needs ~13 glyphs,
   `currentColor` inheritance is required, and no external CDN is allowed
   (docs/11 § 3.6 vendored posture).

   Usage: {% import "icons.peb" %} then {{ icon('mail') }}.
   Every emitted <svg> carries data-icon="<name>" so tests and the
   measurement-annex comparison can assert glyph identity. #}
{% macro icon(name) %}
{%- if name == "mail" -%}
<svg class="ic" data-icon="mail" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V8l8 5 8-5v10zm-8-7L4 6h16l-8 5z"/></svg>
{%- elseif name == "key" -%}
<svg class="ic" data-icon="key" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg>
{%- elseif name == "timer" -%}
<svg class="ic" data-icon="timer" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15 1H9v2h6V1zm-4 13h2V8h-2v6zm8.03-6.61l1.42-1.42c-.43-.51-.9-.99-1.41-1.41l-1.42 1.42C16.07 4.74 14.12 4 12 4c-4.97 0-9 4.03-9 9s4.02 9 9 9 9-4.03 9-9c0-2.12-.74-4.07-1.97-5.61zM12 20c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z"/></svg>
{%- elseif name == "visibility" -%}
