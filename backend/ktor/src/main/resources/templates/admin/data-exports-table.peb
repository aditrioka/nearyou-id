{# Swappable data-export-queue fragment. Rendered standalone for HTMX requests
   (HX-Request: true) and {% include %}d by data-exports.peb for full-page navigation.
   The #data-exports-table id is the hx-target swapped in place.

   Every value is Pebble-autoescaped on output — NO `raw` filter on any value. Escaping
   is LOAD-BEARING: `username` is user-controlled free text, and it is also interpolated
   into the /admin/users?q= deep-link href (attribute/URL context — the route URL-encodes
   the href value too).

   Identity-only PII: no row renders the archive contents, r2_object_key, or signed
   download URL — only the requester identity + lifecycle status.

   CSRF on the per-row trigger form: the full-page (no-JS) render carries `csrfToken` so
   the `_csrf` hidden field populates; the HTMX-fragment render omits it (the layout's
   htmx:configRequest hook adds the X-CSRF-Token header from the meta tag). #}
<div id="data-exports-table">
{% if message is not null %}
    <p class="outcome-message">{{ message }}</p>
{% endif %}
{% if quotaCap is not null %}
    <p class="quota-chip">Trigger actions this hour: {{ quotaUsed }}/{{ quotaCap }}</p>
{% endif %}
{# In-window total scoped to the active filters — the operational signal. #}
<div class="summary">
    <p class="summary-total">Export requests: {{ total }}</p>
</div>
{% if hasRows %}
    <div class="tbl-wrap">
    <table class="tbl">
        <thead>
            <tr>
                <th>User</th>
                <th>Requested (UTC)</th>
                <th>Status</th>
                <th>Delivered via</th>
                <th>Trigger</th>
            </tr>
        </thead>
        <tbody>
        {% for row in rows %}
            <tr>
                <td>
                    <a href="{{ row.usersLink }}">{{ row.username }}</a>
                    <span class="code">{{ row.userIdShort }}</span>
                </td>
                <td>{{ row.requestedAt }}</td>
                <td><span class="st {{ row.statusClass }}">{{ row.statusLabel }}</span></td>
                <td>
                {% if row.delivered %}
                    notif <span class="code">data_export_ready</span> + email
                {% else %}
                    —
                {% endif %}
                </td>
                <td>
                {% if row.triggerable %}
                    <form class="trigger"
                          action="{{ row.triggerAction }}"
                          method="POST"
                          hx-post="{{ row.triggerAction }}"
                          hx-target="#data-exports-table"
                          hx-swap="outerHTML"
                          hx-confirm="Re-run this export through the producer pipeline now? Use this only when the scheduler failed or stalled.">
                        <input type="hidden" name="_csrf" value="{{ csrfToken | default('') }}">
                        <input type="text" name="reason" maxlength="200" placeholder="Reason (required)" required aria-label="Trigger reason">
                        <button type="submit" class="btn tonal sm"><span class="ms">play_arrow</span>Trigger job</button>
                    </form>
                {% else %}
                    —
                {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    {% if nextUrl is not null %}
    <div class="pager">
        <a class="pagination-next"
           href="{{ nextUrl }}"
           hx-get="{{ nextUrl }}"
           hx-target="#data-exports-table"
           hx-swap="outerHTML"
           hx-push-url="true">Next</a>
    </div>
    {% endif %}
{% else %}
    <p class="empty-state">No export requests match the current filters.</p>
{% endif %}
</div>
