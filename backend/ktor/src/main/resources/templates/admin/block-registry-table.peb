{# Swappable block-registry fragment. Rendered standalone for HTMX requests
   (HX-Request: true) and {% include %}d by block-registry.peb for full-page
   navigation. The #block-registry-table id is the hx-target swapped in place.
   Every value is Pebble-autoescaped on output — NO `raw` filter is used on any
   value. Escaping is LOAD-BEARING here: `username` is user-controlled free text
   (unlike the hash-only rejected-identifiers surface), so a username containing
   markup is entity-encoded, never executed. The .tbl-wrap wrapper provides the
   responsive overflow-x scroll. #}
<div id="block-registry-table">
{% if hasRows %}
    <div class="tbl-wrap">
    <table class="tbl">
        <thead>
            <tr>
                <th>Blocker</th>
                <th></th>
                <th>Blocked</th>
                <th>Since (UTC)</th>
                <th>Bidirectional?</th>
            </tr>
        </thead>
        <tbody>
        {% for row in rows %}
            <tr>
                <td><a href="{{ row.blockerUrl }}">{{ row.blockerUsername }}</a></td>
                <td class="block-arrow" aria-label="blocks">&rarr;</td>
                <td><a href="{{ row.blockedUrl }}">{{ row.blockedUsername }}</a></td>
                <td>{{ row.createdAt }}</td>
                <td>{% if row.bidirectional %}yes (mutual){% else %}no{% endif %}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    {% if olderUrl is not null %}
    <div class="pager">
        <a class="pagination-older"
           href="{{ olderUrl }}"
           hx-get="{{ olderUrl }}"
           hx-target="#block-registry-table"
           hx-swap="outerHTML"
           hx-push-url="true">Load older</a>
    </div>
    {% endif %}
{% else %}
    <p class="empty-state">No block pairs match the current search.</p>
{% endif %}
</div>
