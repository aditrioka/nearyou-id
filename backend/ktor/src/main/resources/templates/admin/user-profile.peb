{% extends "layout.peb" %}

{% block title %}User Profile — NearYouID{% endblock %}

{% block content %}
{% import "icons.peb" %}
{# Per-user profile + action-history page (admin-user-management), redlined to
   board frame 6 (page head + quota chip, Actions card, History card) and
   frame 7 (history table + state disclosure). The frame-6 KPI strip
   (Joined / Posts / Followers …) is NOT rendered: it adds data and needs its
   own admin-user-management change.
   Read-only page; the action controls post to the admin-user-moderation routes.
   Every value is Pebble-autoescaped — no `raw` filter is used on any value,
   including the client-controlled username / display_name. #}
{% if profile is not null %}
    <div class="pg-row">
        <div class="grow">
            <h2 class="profile-name">{{ profile.displayName }} <span class="handle">@{{ profile.username }}</span>
                {% if profile.isPremium %}<span class="st prem">{{ icon("workspace_premium") }}PREMIUM</span>{% endif %}
                <span class="st {% if profile.isBanned %}err{% else %}ok{% endif %}">{{ profile.statusLabel }}</span></h2>
            <p class="pg-sub">Profile, history, and moderation actions · <a href="/admin/users">back to lookup</a></p>
        </div>
        <span class="quota" title="Your destructive actions this hour">{{ icon("speed") }}Destructive quota: <b>{{ quotaUsed }}/{{ quotaCap }}</b> this hour</span>
    </div>
{% else %}
    <h2>User Profile</h2>
    <p class="pg-sub">Profile, history, and moderation actions · <a href="/admin/users">back to lookup</a></p>
{% endif %}

{% if message is not null %}
    <p class="outcome-message">{{ message }}</p>
{% endif %}

{% if profile is not null %}
    <section class="user-profile cardlet">
        <h4>{{ icon("badge") }}Profile</h4>
        <dl class="kv">
            <dt>User ID</dt><dd class="user-id"><code class="code">{{ profile.id }}</code></dd>
            <dt>Status</dt><dd class="user-status"><span class="st {% if profile.isBanned %}err{% else %}ok{% endif %}">{{ profile.statusLabel }}</span></dd>
            <dt>Premium</dt><dd class="user-premium">{{ profile.isPremium }} <span class="note">({{ profile.subscriptionStatus }})</span></dd>
            <dt>Account created</dt><dd class="user-created">{{ profile.createdAt }}</dd>
            <dt>Private profile</dt><dd class="user-private">{{ profile.privateProfileOptIn }}</dd>
            <dt>is_banned</dt><dd class="user-is-banned">{{ profile.isBanned }}</dd>
            <dt>suspended_until</dt><dd class="user-suspended-until">{{ profile.suspendedUntil }}</dd>
            <dt>is_shadow_banned</dt><dd class="user-shadow-banned">{{ profile.isShadowBanned }}</dd>
        </dl>
    </section>

    {# State-changing controls (frame 6 Actions card). The board draws bare
       buttons; each shipped action also takes an optional audit-only reason, so
       every button sits in its own tile with the reason field. Each form
       carries a _csrf hidden field for the no-JS POST path; a successful action
       redirects back to the lookup. #}
    <section class="user-actions cardlet">
        <h4>{{ icon("gavel") }}Actions</h4>
        <div class="three-col actions">
            <form class="action-warn action-tile"
                  action="/admin/users/{{ profile.id }}/warn"
                  method="POST">
                <input type="hidden" name="_csrf" value="{{ csrfToken | default('') }}">
                <h4>Warn</h4>
                <label class="field">
                    <span>Reason (optional, audit-only)</span>
                    <input type="text" name="reason" placeholder="e.g. first offense — replies">
                </label>
                <button type="submit" class="btn tonal sm">{{ icon("notification_important") }}Issue warning</button>
            </form>

            <form class="action-suspend action-tile"
                  action="/admin/users/{{ profile.id }}/suspend"
                  method="POST">
                <input type="hidden" name="_csrf" value="{{ csrfToken | default('') }}">
                <h4>Suspend 7 days</h4>
                <label class="field">
                    <span>Reason (optional, audit-only)</span>
                    <input type="text" name="reason" placeholder="e.g. harassment in replies">
                </label>
                <button type="submit" class="btn dangert sm">{{ icon("timer") }}Suspend 7 days</button>
            </form>

            <form class="action-unban action-tile"
                  action="/admin/users/{{ profile.id }}/unban"
                  method="POST">
                <input type="hidden" name="_csrf" value="{{ csrfToken | default('') }}">
                <h4>Unban</h4>
                <label class="field">
                    <span>Reason (optional, audit-only)</span>
                    <input type="text" name="reason" placeholder="e.g. appeal accepted">
                </label>
                <button type="submit" class="btn outl sm">{{ icon("lock_open") }}Unban</button>
                <p class="hint">Lifting a permanent ban requires owner or admin role.</p>
            </form>

            {# Permanent ban — owner/admin only (the higher-trust tier), and only
               when the user is not already permanently banned (a time-bound
               suspension is still escalatable to permanent). #}
            {% if (adminRole == "owner" or adminRole == "admin") and not profile.isPermanentlyBanned %}
            <form class="action-ban action-tile"
                  action="/admin/users/{{ profile.id }}/ban"
                  method="POST">
                <input type="hidden" name="_csrf" value="{{ csrfToken | default('') }}">
                <h4>Permanent ban</h4>
                <label class="field">
                    <span>Reason (optional, audit-only)</span>
                    <input type="text" name="reason" placeholder="e.g. repeat severe violations">
                </label>
                <button type="submit" class="btn danger sm">{{ icon("block") }}Permanently ban</button>
                <p class="hint">Permanent, no automatic unban. Owner/admin only.</p>
            </form>
            {% endif %}

            {# Shadow ban — all write roles; offered only when not already
               shadow-banned (mutually exclusive with un-shadow-ban below). #}
            {% if not profile.isShadowBanned %}
            <form class="action-shadow-ban action-tile"
                  action="/admin/users/{{ profile.id }}/shadow-ban"
                  method="POST">
                <input type="hidden" name="_csrf" value="{{ csrfToken | default('') }}">
                <h4>Shadow ban</h4>
                <label class="field">
                    <span>Reason (optional, audit-only)</span>
                    <input type="text" name="reason" placeholder="e.g. spam ring — silent">
                </label>
                <button type="submit" class="btn outl sm">{{ icon("visibility_off") }}Shadow ban</button>
                <p class="hint">Invisible to the user; no notification.</p>
            </form>
            {% else %}
            <form class="action-shadow-unban action-tile"
                  action="/admin/users/{{ profile.id }}/shadow-unban"
                  method="POST">
                <input type="hidden" name="_csrf" value="{{ csrfToken | default('') }}">
                <h4>Lift shadow ban</h4>
                <label class="field">
                    <span>Reason (optional, audit-only)</span>
                    <input type="text" name="reason" placeholder="e.g. false positive">
                </label>
                <button type="submit" class="btn outl sm">{{ icon("visibility") }}Un-shadow-ban</button>
                <p class="hint">Restorative; not rate-limited.</p>
            </form>
            {% endif %}
        </div>
    </section>

    {# Merged history timeline — admin_actions_log + username_history combined,
       newest-first across BOTH sources (spec: the history view MERGES the two).
       Each entry branches on `kind` (action | username). Frame 6 columns + chip
       tones, frame 7 state disclosure. Kept inline rather than a separate
       HTMX fragment: the profile is a full navigation target and every action
       redirects away, so nothing ever swaps the history on its own. #}
    <section class="user-history cardlet">
        <h4>{{ icon("history") }}History</h4>
        {% if history is empty %}
            <p class="empty-state">No admin actions or username changes recorded for this user.</p>
        {% else %}
        <div class="tbl-wrap">
        <table class="tbl history-merged">
            <thead><tr><th>When (UTC)</th><th>Kind</th><th>Detail</th><th>By</th></tr></thead>
            <tbody>
            {% for h in history %}
                {% if h.kind == "action" %}
                <tr class="hist-action">
                    <td class="t">{{ h.at }}</td>
                    <td><span class="st {% if ['user_suspended', 'user_banned', 'user_shadow_banned'] contains h.actionType %}err{% elseif h.actionType == 'user_warned' %}pend{% elseif ['user_unbanned', 'user_shadow_unbanned'] contains h.actionType %}ok{% else %}info{% endif %}">{{ h.actionType }}</span></td>
                    <td>reason: {{ h.reason }}
                        <details class="state"><summary>state</summary>
                        <div class="statebox">before: {{ h.beforeState }}
after:  {{ h.afterState }}</div></details></td>
                    <td>{{ h.adminDisplayName }}</td>
                </tr>
                {% else %}
                {# username_history is written only by the user's own change flow. #}
                <tr class="hist-username">
                    <td class="t">{{ h.at }}</td>
                    <td><span class="st neut">username_changed</span></td>
                    <td>{{ h.oldUsername }} → {{ h.newUsername }}</td>
                    <td>self</td>
                </tr>
                {% endif %}
            {% endfor %}
            </tbody>
        </table>
        </div>
        {% endif %}
    </section>
{% else %}
    <p class="empty-state">No matching user.</p>
{% endif %}
{% endblock %}
