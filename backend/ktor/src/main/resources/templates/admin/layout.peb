{% import "icons.peb" %}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}NearYouID Admin{% endblock %}</title>
    {% if csrfToken is not null %}
    {# CSRF meta tag — surfaces the per-session CSRF token to client-side JS.
       Per `admin-login-argon2-totp` spec Req "Authenticated layout includes
       CSRF meta tag and HTMX configRequest hook" + design.md D6.
       Rendered ONLY on authenticated pages (no session ⇒ no token). #}
    <meta name="csrf-token" content="{{ csrfToken | escape("html") }}">
    {% endif %}
    {# Vendored panel stylesheet — design language per docs/11 § 3.6
       (canonical board: dev/mockups/nearyou-admin-mockup.html). #}
    <link rel="stylesheet" href="/admin/static/admin.css">
    <script src="/admin/static/htmx.min.js" defer></script>
    {% if csrfToken is not null %}
    <script>
        {# HTMX configRequest listener — auto-adds X-CSRF-Token on every
           HTMX request. Reads the meta tag at request time so a per-login
           rotation propagates without page reload. #}
        document.addEventListener('htmx:configRequest', function (evt) {
            var meta = document.querySelector('meta[name="csrf-token"]');
            if (meta) {
                evt.detail.headers['X-CSRF-Token'] = meta.content;
            }
        });
    </script>
    {% endif %}
</head>
<body class="{% if csrfToken is not null %}shell{% else %}bare{% endif %}">
    {% if csrfToken is not null %}
    {# Pure-CSS hamburger-drawer toggle (frame-4b responsive contract): the
       checkbox is visually hidden; the header burger label and the scrim
       label toggle it below ~1024 px. No JS involved. #}
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle navigation">
    {# Top bar (mockup frame 2): burger (narrow viewports) + active page
       title crumb + deployment-environment chip. #}
    <header>
        <label for="nav-toggle" class="nav-burger" aria-hidden="true"><span></span><span></span><span></span></label>
        <div class="crumb"><b>{{ pageTitle }}</b></div>
        <div class="spacer"></div>
        <span class="envchip">{{ envName }}</span>
    </header>
    {# Grouped sidebar — shipped pages only (admin-mockup-parity design.md
       D8): no Usulan placeholders, no board-annotation status dots. The
       Dashboard item is the shipped /admin/ landing. #}
    <nav>
        <span class="brand">
            <svg viewBox="31 31 46 46" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="NearYouID"><path d="M43.8,50.2 L54,56.1 L64.2,50.2 L64.2,38.5 L54,32.6 L43.8,38.5 L43.8,45.5"/><path d="M54,56.1 L43.8,50.2 L33.7,56.1 L33.7,67.9 L43.8,73.7 L46.3,73.7"/><path d="M64.2,73.7 L74.3,67.9 L74.3,56.1 L68.3,52.6"/><path d="M64.2,73.7 L56.7,73.7"/><circle cx="51.5" cy="73.7" r="2" fill="currentColor" stroke="none"/></svg>
        </span>
        <span class="ngroup">Moderasi</span>
        <a class="nitem{% if activePath == "/admin/" %} active{% endif %}" href="/admin/">{{ icon("dashboard") }}Dashboard</a>
        <a class="nitem{% if activePath == "/admin/reports" %} active{% endif %}" href="/admin/reports">{{ icon("flag") }}Reports</a>
        <a class="nitem{% if activePath == "/admin/appeals" %} active{% endif %}" href="/admin/appeals">{{ icon("article") }}Appeals</a>
        <a class="nitem{% if activePath == "/admin/users" %} active{% endif %}" href="/admin/users">{{ icon("group") }}Users</a>
        <span class="ngroup">Anti-abuse &amp; keamanan</span>
        <a class="nitem{% if activePath == "/admin/rejected-identifiers" %} active{% endif %}" href="/admin/rejected-identifiers">{{ icon("block") }}Rejected identifiers</a>
        <a class="nitem{% if activePath == "/admin/blocks" %} active{% endif %}" href="/admin/blocks">{{ icon("group") }}Block registry</a>
        <a class="nitem{% if activePath == "/admin/csam" %} active{% endif %}" href="/admin/csam">{{ icon("gpp_maybe") }}CSAM detection log</a>
        <span class="ngroup">Lifecycle</span>
        <a class="nitem{% if activePath == "/admin/privacy-flips" %} active{% endif %}" href="/admin/privacy-flips">{{ icon("timer") }}Privacy flips</a>
        <a class="nitem{% if activePath == "/admin/deletion-requests" %} active{% endif %}" href="/admin/deletion-requests">{{ icon("auto_delete") }}Hard delete queue</a>
        <a class="nitem{% if activePath == "/admin/data-exports" %} active{% endif %}" href="/admin/data-exports">{{ icon("download") }}Data export queue</a>
        <span class="ngroup">Premium</span>
        <a class="nitem{% if activePath == "/admin/subscriptions/grace" %} active{% endif %}" href="/admin/subscriptions/grace">{{ icon("credit_card") }}Subscription grace</a>
        <span class="ngroup">Konfigurasi</span>
        <a class="nitem{% if activePath == "/admin/feature-flags" %} active{% endif %}" href="/admin/feature-flags">{{ icon("toggle_on") }}Feature flags</a>
        <a class="nitem{% if activePath == "/admin/reserved-usernames" %} active{% endif %}" href="/admin/reserved-usernames">{{ icon("badge") }}Reserved usernames</a>
        <a class="nitem{% if activePath == "/admin/username-oversight" %} active{% endif %}" href="/admin/username-oversight">{{ icon("alternate_email") }}Username oversight</a>
        <span class="ngroup">Sistem</span>
        <a class="nitem{% if activePath == "/admin/actions-log" %} active{% endif %}" href="/admin/actions-log">{{ icon("receipt_long") }}Audit log</a>
        {# Identity box (design.md D5): role chip + display name + the
           session line (idle window + the sooner of idle-deadline /
           absolute-cap expiry, HH:mm UTC) + logout. #}
        <div class="session">
            <div class="session-id"><span class="rolechip {{ adminRole }}">{{ adminRole | upper }}</span><b>{{ adminName }}</b></div>
            <div class="session-line">Session idle {{ sessionIdleMinutes }} m · expires {{ sessionExpiresAt }} UTC</div>
            <form action="/admin/logout" method="POST">
                <input type="hidden" name="_csrf" value="{{ csrfToken | escape("html") }}">
                <button type="submit" class="btn outl sm block">{{ icon("logout") }}Logout</button>
            </form>
        </div>
    </nav>
    <label for="nav-toggle" class="nav-scrim" aria-hidden="true"></label>
    {% endif %}
    <main>
        {% block content %}{% endblock %}
    </main>
</body>
</html>
