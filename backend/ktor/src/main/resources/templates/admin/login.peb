{% extends "layout.peb" %}

{% block title %}Login — NearYouID Admin{% endblock %}

{% block content %}
{% import "icons.peb" %}
{# Mockup frame 1 (admin-mockup-parity): logo only — no heading text; start
   icons on each input; password visibility toggle; error banner with icon.
   The error banner stays ONE generic slot — byte-identical markup on every
   failure path (admin-login no-enumeration requirement). #}
<div class="login-card">
    <span class="brand">
        <svg viewBox="31 31 46 46" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="NearYouID"><path d="M43.8,50.2 L54,56.1 L64.2,50.2 L64.2,38.5 L54,32.6 L43.8,38.5 L43.8,45.5"/><path d="M54,56.1 L43.8,50.2 L33.7,56.1 L33.7,67.9 L43.8,73.7 L46.3,73.7"/><path d="M64.2,73.7 L74.3,67.9 L74.3,56.1 L68.3,52.6"/><path d="M64.2,73.7 L56.7,73.7"/><circle cx="51.5" cy="73.7" r="2" fill="currentColor" stroke="none"/></svg>
    </span>
    {% if errorMessage is not null %}
    <p class="error" role="alert">{{ icon("error") }}<span>{{ errorMessage }}</span></p>
    {% endif %}
    <form action="/admin/login" method="POST">
        <label class="fld" for="email">
            <span>Email</span>
            <span class="inp-wrap">{{ icon("mail") }}<input type="email" name="email" id="email" required autocomplete="username" placeholder="admin@nearyou.id"></span>
        </label>
        <label class="fld" for="password">
            <span>Password</span>
            <span class="inp-wrap">{{ icon("key") }}<input type="password" name="password" id="password" required autocomplete="current-password" placeholder="Your password"><button type="button" id="pw-toggle" class="pw-toggle" aria-label="Show password" aria-pressed="false">{{ icon("visibility") }}<span hidden>{{ icon("visibility_off") }}</span></button></span>
        </label>
        <label class="fld" for="totp">
            <span>TOTP code</span>
            <span class="inp-wrap">{{ icon("timer") }}<input type="text" name="totp" id="totp" pattern="\d{6}" maxlength="6" minlength="6" required
                   autocomplete="one-time-code" inputmode="numeric" placeholder="6-digit code"></span>
            <span class="hint">From your authenticator app. Required every login.</span>
        </label>
        <button type="submit" class="btn filled block">Login</button>
    </form>
</div>
{# The #pw-toggle wiring lives in the vendored admin.js (CSP 'self'). #}
{% endblock %}
