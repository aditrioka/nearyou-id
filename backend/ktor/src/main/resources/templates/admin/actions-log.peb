{% extends "layout.peb" %}

{% block title %}Audit Log — NearYouID{% endblock %}

{% block content %}
<h2>Audit Log</h2>

{# Filter form. hx-get swaps only the #actions-log-table fragment; method=GET
   means it also works as a plain navigation when JS is unavailable
   (progressive enhancement — design.md D3). All values are autoescaped. #}
<form hx-get="/admin/actions-log"
      hx-target="#actions-log-table"
      hx-swap="outerHTML"
      hx-push-url="true"
      method="GET">
    <label>Action type
        <input type="text" name="action_type" value="{{ filters.action_type | default('') }}">
    </label>
    <label>Admin ID
        <input type="text" name="admin_id" value="{{ filters.admin_id | default('') }}">
    </label>
    <label>Target type
        <input type="text" name="target_type" value="{{ filters.target_type | default('') }}">
    </label>
    <label>Target ID
        <input type="text" name="target_id" value="{{ filters.target_id | default('') }}">
    </label>
    <label>From
        <input type="date" name="from" value="{{ filters.from | default('') }}">
    </label>
    <label>To
        <input type="date" name="to" value="{{ filters.to | default('') }}">
    </label>
    <button type="submit">Filter</button>
</form>

{% include "actions-log-table.peb" %}
{% endblock %}
