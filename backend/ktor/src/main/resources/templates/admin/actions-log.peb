{% extends "layout.peb" %}

{% block title %}Audit Log — NearYouID{% endblock %}

{% block content %}
<h2>Audit Log</h2>
<p class="pg-sub">admin_actions_log — immutable · written automatically by every panel mutation</p>

{# Filter form. hx-get swaps only the #actions-log-table fragment; method=GET
   means it also works as a plain navigation when JS is unavailable
   (progressive enhancement — design.md D3). All values are autoescaped.
   The .filters-toggle checkbox is the pure-CSS "Filters" disclosure of the
   frame-4b responsive contract. #}
<div class="filterbar">
    <input type="checkbox" id="filters-toggle" class="filters-toggle" aria-label="Toggle filters">
    <label for="filters-toggle" class="btn tonal sm filters-label">Filters</label>
    <span class="filters-chips">{% for f in filters %}{% if f.value is not empty %}<span class="pill">{{ f.key }}: {{ f.value }}</span>{% endif %}{% endfor %}</span>
    <form class="filters"
          hx-get="/admin/actions-log"
          hx-target="#actions-log-table"
          hx-swap="outerHTML"
          hx-push-url="true"
          method="GET">
        <label class="field">
            <span>Action type</span>
            <input type="text" name="action_type" value="{{ filters.action_type | default('') }}">
        </label>
        <label class="field">
            <span>Admin ID</span>
            <input type="text" name="admin_id" value="{{ filters.admin_id | default('') }}" placeholder="uuid">
        </label>
        <label class="field">
            <span>Target type</span>
            <input type="text" name="target_type" value="{{ filters.target_type | default('') }}" placeholder="user / report / …">
        </label>
        <label class="field">
            <span>Target ID</span>
            <input type="text" name="target_id" value="{{ filters.target_id | default('') }}" placeholder="uuid">
        </label>
        <label class="field">
            <span>From</span>
            <input type="date" name="from" value="{{ filters.from | default('') }}">
        </label>
        <label class="field">
            <span>To</span>
            <input type="date" name="to" value="{{ filters.to | default('') }}">
        </label>
        <button type="submit" class="btn filled">Filter</button>
    </form>
</div>

{% include "actions-log-table.peb" %}
{% endblock %}
