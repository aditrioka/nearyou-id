<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  IN-TREE PLACEHOLDER (mobile-auth-google-signin-flow, Mobile #3).

  This .template ships in the repo; the REAL per-environment GoogleService-Info.plist is NOT
  committed (it is sensitive when paired with the iOS bundle ID via Apple's app-binding model).
  Pull the real plist from GCP Secret Manager at Xcode build time and drop it next to this file
  as `GoogleService-Info.plist`. See dev/docs/google-cloud-oauth-clients.md.

  CLIENT_ID feeds Info.plist's GIDClientID ($(GID_CLIENT_ID)); REVERSED_CLIENT_ID feeds the
  CFBundleURLTypes scheme. Both MUST match the OAuth iOS client provisioned for the build's
  bundle identifier (id.nearyou.app.staging / id.nearyou.app).
-->
<plist version="1.0">
<dict>
	<key>CLIENT_ID</key>
	<string>PLACEHOLDER-CLIENT-ID.apps.googleusercontent.com</string>
	<key>REVERSED_CLIENT_ID</key>
	<string>com.googleusercontent.apps.PLACEHOLDER-REVERSED-CLIENT-ID</string>
	<key>BUNDLE_ID</key>
	<string>id.nearyou.app.staging</string>
	<key>IS_SIGNIN_ENABLED</key>
	<true/>
</dict>
</plist>
