#include "Config.xcconfig"

// Dev (local) environment — mobile-ios-build-config-matrix. iOS dev parity with the Android `dev`
// flavor: distinct `.dev` bundle id (side-by-side install) + the forest-green AppIcon-Dev.
PRODUCT_BUNDLE_IDENTIFIER=id.nearyou.app.dev

// Launcher icon — forest green #15803D (AppIcon-Dev.appiconset).
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-Dev

// iOS-dev API: the simulator shares the Mac's network, so the local backend is reachable at
// localhost:8080 (NOT 10.0.2.2 — that's the Android emulator's host alias). Cleartext http://
// to localhost is permitted by the Info.plist `NSAllowsLocalNetworking` ATS exception. `//` is an
// xcconfig comment, so build it from $(NY_SLASH) (inherited from Config.xcconfig) — see Config.xcconfig.
APP_API_BASE_URL=http:$(NY_SLASH)$(NY_SLASH)localhost:8080

// GID is inherited from Config.xcconfig (staging client). A real `.dev` iOS OAuth client is not
// provisioned, so Google Sign-In won't complete on a dev build — acceptable for UI/dev testing.
