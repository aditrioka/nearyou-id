<?xml version="1.0" encoding="utf-8"?>
<!--
  DEV-FLAVOR ONLY manifest overlay. AGP merges this into the `dev` variant manifest only;
  staging/production never see DevTestLoginActivity. The exported deep-link entry is acceptable
  here because it exists solely in the dev (test-automation) build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="id.nearyou.app.dev.DevTestLoginActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nearyou-dev" android:host="test-login" />
            </intent-filter>
        </activity>
    </application>
</manifest>
