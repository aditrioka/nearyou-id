<?xml version="1.0" encoding="utf-8"?>
<!--
  DEV-FLAVOR ONLY manifest overlay. AGP merges this into the `dev` variant manifest only;
  staging/production never see DevTestLoginActivity. The exported deep-link entry is acceptable
  here because it exists solely in the dev (test-automation) build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- networkSecurityConfig: dev-only local-host cleartext allowlist (see res/xml/
         network_security_config.xml). Without it Android blocks http:// to the local backend
         on BOTH the emulator (10.0.2.2) and a device via adb reverse (localhost). -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name="id.nearyou.app.dev.DevTestLoginActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nearyou-dev" android:host="test-login" />
            </intent-filter>
        </activity>
    </application>
</manifest>
