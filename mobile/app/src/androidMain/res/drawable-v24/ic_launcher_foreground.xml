<?xml version="1.0" encoding="utf-8"?>
<!--
  NearYouID brand foreground glyph — white hexagon-cluster on transparent.
  Extracted from logo_brand_dark.svg (viewBox 108×108) by dropping the
  background <rect> and converting the SVG <polyline> + <circle> into Android
  vector pathData. Stroke width 3 + round line caps match the source SVG's
  class="st1" style. The dot at (51.5, 73.7) is a filled circle approximated
  via arc-pathData (two semicircles).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Outer hexagon — top group -->
    <path
        android:pathData="M43.8,50.2 L54,56.1 L64.2,50.2 L64.2,38.5 L54,32.6 L43.8,38.5 L43.8,43.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Inner hexagon — left group -->
    <path
        android:pathData="M54,56.1 L43.8,50.2 L33.7,56.1 L33.7,67.9 L43.8,73.7 L46.3,73.7"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Right segment -->
    <path
        android:pathData="M64.2,73.7 L74.3,67.9 L74.3,56.1 L68.9,53"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Bottom connector -->
    <path
        android:pathData="M64.2,73.7 L56.7,73.7"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- Filled dot at (51.5, 73.7), radius 2 — two arc semicircles -->
    <path
        android:pathData="M49.5,73.7 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 Z"
        android:fillColor="#FFFFFF" />
</vector>
