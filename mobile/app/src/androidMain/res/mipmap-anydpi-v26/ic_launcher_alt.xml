<?xml version="1.0" encoding="utf-8"?>
<!--
  Alternate launcher icon (blue-on-white) per design.md Decision 7.
  Wired via <activity-alias android:name=".MainActivityAlt"
  android:icon="@mipmap/ic_launcher_alt" android:enabled="false"> in
  AndroidManifest.xml — dormant until a future user-selectable icon-theme
  feature flips it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_alt" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
