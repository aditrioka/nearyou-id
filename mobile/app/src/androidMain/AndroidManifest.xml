<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      mobile-location-permission-flow — coarse/approximate location only (Free tier is a fixed 20km
      radius; UU-PDP data minimization). Deliberately NO ACCESS_FINE_LOCATION and NO background/
      ACCESS_BACKGROUND_LOCATION; precise location is deferred with the radius slider.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      allowBackup=false (2026-06-10 audit, finding 07-#1): auto-backup/D2D transfer
      restored the Tink-encrypted DataStore prefs WITHOUT the Android-Keystore
      master key (Keystore keys never leave the device), so the first token write
      after a device migration crashed on an un-unwrappable keyset — and a
      reinstall could re-restore the poisoned prefs. The app's only local state is
      session tokens (which must never move between devices) + re-fetchable prefs,
      so disabling backup wholesale is the correct posture.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NearYou.Launch">
        <activity
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          mobile-fcm-token-registration — bridges the FCM token-rotation callback (onNewToken) into the
          commonMain FcmTokenProvider.tokenRefreshes Flow. exported=false (the OS binds it directly). Without
          a configured FirebaseApp (google-services.json + the google-services plugin = OPERATOR setup), the
          SDK never dispatches to it — the service is inert, consistent with currentToken() returning null.
        -->
        <service
            android:name=".push.NearYouFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          Dormant alternate launcher icon (blue-on-white) per
          shared-resources-moko-bootstrap design.md Decision 7. Disabled by
          default; ready for a future user-selectable icon-theme feature that
          flips this alias on while disabling MainActivity's launcher entry.
        -->
        <activity-alias
            android:name=".MainActivityAlt"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_alt"
            android:roundIcon="@mipmap/ic_launcher_alt"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>