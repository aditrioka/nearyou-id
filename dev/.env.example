# Copy to dev/.env and fill in. dev/.env is gitignored.

# Postgres (consumed by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nearyou_dev

# Backend DB connection (consumed by Ktor + Flyway)
DB_URL=jdbc:postgresql://localhost:5433/nearyou_dev
DB_USER=postgres
DB_PASSWORD=postgres

# Ktor environment selector: test | development | staging | production.
# `test` boots with NO external-service credentials — Redis, Firebase
# (firebase-admin-sa), OpenAI (openai-api-key) and the Supabase data-plane all
# stub or fail-soft — so it's the quickest local boot. `development` and above
# additionally require the firebase-admin-sa + openai-api-key secrets (and
# staging/production hard-require Redis).
KTOR_ENV=development

# RSA key for access-token signing.
# Generate with: dev/scripts/generate-rsa-keypair.sh
# Value is base64-encoded PKCS#8 PEM private key.
KTOR_RSA_PRIVATE_KEY=

# HMAC secret for Supabase realtime tokens (HS256).
# Use any 32-byte random base64 in dev: openssl rand -base64 32
SUPABASE_JWT_SECRET=

# Base URL of the Supabase project edge (REST + Realtime).
# Required at boot in EVERY env — Application.kt fail-fasts on a blank value
# (auth.supabaseUrl). Consumed as ${SUPABASE_URL}/rest/v1/ by the realtime token
# issuer + the /health Supabase probe (the probe is fail-soft, so a non-running
# target is fine for boot). Local Supabase CLI default API gateway:
SUPABASE_URL=http://localhost:54321

# Comma-separated allow-lists for ID-token aud claims.
# Empty until Google/Apple OAuth client IDs are provisioned.
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_IDS=

# OIDC audience for /internal/* worker endpoints (Cloud-Scheduler-invoked).
# Required at boot in EVERY env (oidc.internalAudience) and MUST be a
# syntactically valid URL. In staging/prod this is the deployed Cloud Run
# service URL (e.g. https://api-staging.nearyou.id) that the Google-signed OIDC
# token's `aud` claim must match; locally any valid URL works since /internal/*
# isn't exercised by real OIDC tokens in dev.
INTERNAL_OIDC_AUDIENCE=http://localhost:8080

# HMAC key for deterministic invite-code derivation (HMAC-SHA256).
# 32 raw random bytes, base64-encoded. Generate with: openssl rand -base64 32
# Resolved via SecretResolver under the name "invite-code-secret".
INVITE_CODE_SECRET=

# HMAC key for coordinate jitter (HMAC-SHA256) — docs/05-Implementation.md § Coordinate Fuzzing.
# 32 raw random bytes, base64-encoded. Generate with: openssl rand -base64 32
# Resolved via SecretResolver under the name "jitter-secret".
# Rotation is an incident-only operation (docs/08 Decision 20): rotating
# requires re-fuzzing every posts row via a Cloud Run Jobs batch.
JITTER_SECRET=
